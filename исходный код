                buf = io.BytesIO()
                src.resize(size, Image.LANCZOS).save(buf, "PNG")
                self.core.replace_client_file("cursors", t, buf.getvalue())
                n += 1
            except Exception:
                pass
        self.mods["cursor"] = {"kind": None, "path": path}
        self.mark_mods_version()
        self.toast(f"Свой курсор применён ({n} файлов)", "ok")
