    def refresh_sound_rows(self):
        for w in self.sound_rows.winfo_children():
            w.destroy()
        self.sound_status.clear()
        files = self.core.list_sounds()
        if not files:
            ctk.CTkLabel(self.sound_rows, text="Звуковые файлы клиента не найдены.",
                         font=F(12), text_color=MUTED).pack(anchor="w", padx=6, pady=8)
            return
        for f in files[:14]:
            row = ctk.CTkFrame(self.sound_rows, fg_color=CARD2, corner_radius=10)
            row.pack(fill="x", padx=4, pady=3)
            ctk.CTkLabel(row, text=f.name, font=F(12), text_color=TEXT, width=240,
                         anchor="w").pack(side="left", padx=(12, 6), pady=8)
            st = ctk.CTkLabel(row, text="", font=F(11), text_color=MUTED)
            st.pack(side="left", padx=(0, 8))
            self.sound_status[f.name] = st
            ctk.CTkButton(row, text="Сброс", width=64, height=28, corner_radius=8, font=F(11),
                          fg_color=CARD, hover_color=RED, text_color=MUTED,
                          command=lambda n=f.name: self.restore_one("sounds", n)
                          ).pack(side="right", padx=(0, 10), pady=6)
            ctk.CTkButton(row, text="Заменить…", width=92, height=28, corner_radius=8, font=F(11, "bold"),
                          fg_color=self.accent, hover_color=mix(self.accent, "#FFFFFF", 0.18),
                          command=lambda n=f.name: self.replace_sound(n)
                          ).pack(side="right", padx=(0, 6), pady=6)
        if len(files) > 14:
            ctk.CTkLabel(self.sound_rows, text=f"…и ещё {len(files) - 14} файлов в папке клиента.",
                         font=F(11), text_color=MUTED).pack(anchor="w", padx=6, pady=(4, 8))
        self.refresh_mod_labels("sounds")

    def replace_sound(self, name):
        path = filedialog.askopenfilename(title="Выберите звук",
                                          filetypes=[("Аудио", "*.wav *.mp3 *.ogg"), ("Все файлы", "*.*")])
        if not path:
            return
        base = self.core.sounds_dir()
        if not base:
            self.toast("Клиент Roblox не найден", "err")
            return
        try:
            self.core.replace_client_file("sounds", base / name, Path(path).read_bytes())
            self.mods["sounds"][name] = path
            self.mark_mods_version()
            self.toast(f"Звук заменён: {name}", "ok")
        except Exception as e:
            self.toast(f"Ошибка замены: {e}", "err")
        self.refresh_mod_labels("sounds")

