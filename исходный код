def rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))

def hx(t):
    return "#%02X%02X%02X" % tuple(max(0, min(255, int(v))) for v in t)

def mix(a, b, t):
    ra, rb = rgb(a), rgb(b)
    return hx(tuple(ra[i] + (rb[i] - ra[i]) * t for i in range(3)))

def hue_shift(h, dh):
    r, g, b = [v / 255 for v in rgb(h)]
    hh, s, v = colorsys.rgb_to_hsv(r, g, b)
    r, g, b = colorsys.hsv_to_rgb((hh + dh) % 1.0, min(1, s * 1.05), v)
    return hx((r * 255, g * 255, b * 255))

_FONTS = []
def F(size, weight="normal"):
    f = ctk.CTkFont(family="Segoe UI", size=size, weight=weight)
    _FONTS.append((f, size))
    return f

def pil_font(size, bold=True):
    names = ("segoeuib.ttf", "arialbd.ttf", "arial.ttf") if bold else ("segoeui.ttf", "arial.ttf")
    for n in names:
        try:
            return ImageFont.truetype(n, size)
        except Exception:
            pass
    return ImageFont.load_default()

