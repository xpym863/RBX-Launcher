        self.lbl_paths.configure(text=f"Roblox:  {self.core.roblox_root}\nДанные:  {self.core.data_dir}")
        self.lbl_flags_path.configure(text=str(ver / "ClientSettings" / "ClientAppSettings.json")
                                      if ver else "Клиент не найден")

