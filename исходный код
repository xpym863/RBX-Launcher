    def apply_cursor_preset(self, kind):
        targets = self._cursor_targets()
        if not targets:
            self.toast("Курсоры клиента не найдены", "err")
            return
        n = 0
        for t in targets:
            try:
                with Image.open(t) as im:
                    size = im.size[0]
                buf = io.BytesIO()
                make_cursor(kind, size, self.accent).save(buf, "PNG")
                self.core.replace_client_file("cursors", t, buf.getvalue())
                n += 1
            except Exception:
                pass
        self.mods["cursor"] = {"kind": kind, "path": None}
        self.mark_mods_version()
        self.toast(f"Курсор игры: {dict(CURSOR_PRESETS).get(kind, kind)} ({n} файлов)", "ok")
        self.refresh_cursor_status()

