    def show_page(self, key):
        self.current_page = key
        for f in self.page_frames.values():
            f.pack_forget()
        self.page_frames[key].pack(fill="both", expand=True)
        for k, b in self.nav.items():
            if k == key:
                b.configure(fg_color=mix(self.accent, BG, 0.82), text_color=TEXT)
            else:
                b.configure(fg_color="transparent", text_color=MUTED)
        if key == "sound":
            self.refresh_sound_rows()
        elif key == "font":
            self.refresh_font_status()
        elif key == "cursor":
            self.refresh_cursor_status()
        elif key == "about":
            self.refresh_history()
        elif key == "play":
            self.refresh_recent()
            self.after(60, self.regen_banner)

