    # ---------------- статус / тост ----------------
    def build_toast(self):
        self.toast_bar = ctk.CTkFrame(self, height=38, corner_radius=0, fg_color=SIDEBAR)
        self.toast_bar.grid(row=1, column=0, columnspan=2, sticky="ew")
        self.toast_bar.grid_propagate(False)
        self.toast_lbl = ctk.CTkLabel(self.toast_bar, text="Готов к запуску", font=F(12), text_color=MUTED)
        self.toast_lbl.pack(side="left", padx=18)
        self.toast_btn = ctk.CTkButton(self.toast_bar, text="Вернуть", width=80, height=26, corner_radius=8,
                                       font=F(11, "bold"), fg_color=CARD2, hover_color=BORDER,
                                       text_color=TEXT, command=self.do_undo)

    def toast(self, msg, kind="info", undo=None):
        colors = {"info": MUTED, "ok": GREEN, "warn": AMBER, "err": RED}
        self.toast_lbl.configure(text=msg, text_color=colors.get(kind, MUTED))
        self._undo = undo
        if undo:
            self.toast_btn.pack(side="right", padx=14)
        else:
            self.toast_btn.pack_forget()
        if self._toast_after:
            self.after_cancel(self._toast_after)
        self._toast_after = self.after(6000, lambda: self.toast_lbl.configure(
            text="Готов к запуску", text_color=MUTED))

    def do_undo(self):
        if self._undo:
            fn, self._undo = self._undo, None
            fn()
        self.toast_btn.pack_forget()

