    def mark_mods_version(self):
        v = self.core.get_latest_version_dir()
        self.mods["version"] = v.name if v else None
        self.save_config()

    def check_mods_version(self):
        v = self.core.get_latest_version_dir()
        if not v or not self.mods.get("version"):
            return
        has = self.mods.get("font") or self.mods.get("cursor") or self.mods.get("sounds")
        if has and v.name != self.mods["version"]:
            self.toast("Roblox обновился — нажмите «Переустановить мои моды» в Настройках", "warn")

    def reapply_mods(self):
        n = 0
        fp = self.mods.get("font")
        if fp and Path(fp).exists():
            data = Path(fp).read_bytes()
            for t in self.core.list_fonts():
                try:
                    self.core.replace_client_file("fonts", t, data)
                    n += 1
                except Exception:
                    pass
        cur = self.mods.get("cursor") or {}
        targets = self._cursor_targets()
        if cur.get("kind"):
            for t in targets:
                try:
                    with Image.open(t) as im:
                        size = im.size[0]
                    buf = io.BytesIO()
                    make_cursor(cur["kind"], size, self.accent).save(buf, "PNG")
                    self.core.replace_client_file("cursors", t, buf.getvalue())
                    n += 1
                except Exception:
                    pass
        elif cur.get("path") and Path(cur["path"]).exists():
            try:
                src = Image.open(cur["path"]).convert("RGBA")
                for t in targets:
                    with Image.open(t) as im:
                        size = im.size
                    buf = io.BytesIO()
                    src.resize(size, Image.LANCZOS).save(buf, "PNG")
                    self.core.replace_client_file("cursors", t, buf.getvalue())
                    n += 1
            except Exception:
                pass
        base = self.core.sounds_dir()
        if base:
            for name, path in (self.mods.get("sounds") or {}).items():
                if Path(path).exists() and (base / name).exists():
                    try:
                        self.core.replace_client_file("sounds", base / name, Path(path).read_bytes())
                        n += 1
                    except Exception:
                        pass
        self.mark_mods_version()
        self.toast(f"Моды переустановлены: {n} файлов" if n else "Нет сохранённых модов для установки",
                     "ok" if n else "warn")

    def reset_all_mods(self):
        total = sum(self.core.restore_category(c) for c in ("sounds", "fonts", "cursors"))
        self.mods = {"font": None, "cursor": None, "sounds": {}, "version": None}
        self.save_config()
        self.toast(f"Все моды сняты, оригиналы возвращены ({total} файлов)", "ok")

    def save_profile(self):
        name = self.entry_profile.get().strip()
        if not name:
            self.toast("Введите имя профиля", "err")
            return
        self.profiles = [p for p in self.profiles if p["name"] != name]
        self.profiles.append({"name": name, "settings": dict(self.settings)})
        self.entry_profile.delete(0, "end")
        self.save_config()
        self.refresh_profiles()
        self.toast(f"Профиль «{name}» сохранён", "ok")

    def refresh_profiles(self):
        for w in self.profile_rows.winfo_children():
            w.destroy()
        if not self.profiles:
            ctk.CTkLabel(self.profile_rows, text="Профилей пока нет — настройте лаунчер и сохраните пресет.",
                         font=F(11), text_color=MUTED).pack(anchor="w", padx=6, pady=6)
            return
        for prof in self.profiles:
            row = ctk.CTkFrame(self.profile_rows, fg_color=CARD2, corner_radius=10)
            row.pack(fill="x", padx=4, pady=3)
            ctk.CTkLabel(row, text=prof["name"], font=F(12, "bold"),
                         text_color=TEXT).pack(side="left", padx=(12, 8), pady=8)
            s = prof.get("settings", {})
            ctk.CTkLabel(row, text=f"граф. {s.get('graphics')} • FPS {s.get('fps')} • громк. {s.get('volume')}%",
                         font=F(11), text_color=MUTED).pack(side="left")
            ctk.CTkButton(row, text="✕", width=30, height=28, corner_radius=8, font=F(11),
                          fg_color=CARD, hover_color=RED, text_color=MUTED,
                          command=lambda n=prof["name"]: self.delete_profile(n)
                          ).pack(side="right", padx=(0, 10), pady=6)
            ctk.CTkButton(row, text="Загрузить", width=90, height=28, corner_radius=8, font=F(11, "bold"),
                          fg_color=self.accent, hover_color=mix(self.accent, "#FFFFFF", 0.18),
                          command=lambda n=prof["name"]: self.load_profile(n)
                          ).pack(side="right", padx=(0, 6), pady=6)

    def load_profile(self, name):
        prof = next((p for p in self.profiles if p["name"] == name), None)
        if not prof:
            return
        self.settings.update(prof.get("settings", {}))
        self.save_config()
        self.refresh_controls()
        self.toast(f"Профиль «{name}» загружен", "ok")

    def delete_profile(self, name):
        self.profiles = [p for p in self.profiles if p["name"] != name]
        self.save_config()
        self.refresh_profiles()
        self.toast(f"Профиль «{name}» удалён", "warn")

    def refresh_controls(self):
        self.accent = ACCENTS.get(self.settings["accent"], ACCENTS["Синий"])
        self.slider_gfx.set(self.settings["graphics"])
        self.lbl_gfx.configure(text=f"Уровень графики: {self.settings['graphics']} / 10")
        self.var_shift.set(self.settings["shiftlock"])
        self.slider_vol.set(self.settings["volume"])
        self.lbl_vol.configure(text=f"Общая громкость: {self.settings['volume']}%")
        self.var_mute.set(self.settings["volume"] == 0)
        self.entry_fps.delete(0, "end")
        self.entry_fps.insert(0, str(self.settings["fps"]))
        self.var_showfps.set(self.settings["show_fps"])
        self.var_postfx.set(self.settings["postfx_off"])
        self.opt_render.set(self.settings["rendering"])
        self.var_apply.set(self.settings["apply_on_launch"])
        self.var_close.set(self.settings["close_after"])
        self.entry_font.delete(0, "end")
        self.entry_font.insert(0, self.settings["ui_font"])
        self.slider_scale.set(self.settings["ui_scale"])
        self.lbl_scale.configure(text=f"Масштаб текста: {int(round(self.settings['ui_scale'] * 100))}%")
        self.opt_lcursor.set(self.settings["launcher_cursor"])
        self.refresh_accent_widgets()
        self.apply_ui_font()
        self.apply_launcher_cursor()

    def export_config(self):
        path = filedialog.asksaveasfilename(title="Экспорт настроек", defaultextension=".json",
                                            filetypes=[("JSON", "*.json")])
        if not path:
            return
        try:
            Path(path).write_text(json.dumps({"settings": self.settings, "games": self.games,
                                              "profiles": self.profiles, "mods": self.mods},
                                             indent=4, ensure_ascii=False), encoding="utf-8")
            self.toast("Настройки экспортированы", "ok")
        except Exception as e:
            self.toast(f"Ошибка экспорта: {e}", "err")

    def import_config(self):
        path = filedialog.askopenfilename(title="Импорт настроек", filetypes=[("JSON", "*.json")])
        if not path:
            return
        try:
            data = json.loads(Path(path).read_text(encoding="utf-8"))
            self.settings.update(data.get("settings", {}))
            if isinstance(data.get("games"), list):
                self.games = [g for g in data["games"] if g.get("id")]
            if isinstance(data.get("profiles"), list):
                self.profiles = data["profiles"]
            if isinstance(data.get("mods"), dict):
                self.mods.update(data["mods"])
            self.save_config()
            self.refresh_controls()
            self.rebuild_games()
            self.refresh_profiles()
            self.toast("Настройки импортированы", "ok")
        except Exception as e:
            self.toast(f"Ошибка импорта: {e}", "err")

    def clear_logs(self):
        d = self.core.roblox_root / "logs"
        if d.exists():
            shutil.rmtree(d, ignore_errors=True)
            self.toast("Логи Roblox очищены", "ok")
        else:
            self.toast("Папка логов не найдена", "warn")

