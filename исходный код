    # ---------------- конфигурация ----------------
    def load_config(self):
        try:
            if self.core.config_file.exists():
                data = json.loads(self.core.config_file.read_text(encoding="utf-8"))
                self.settings.update(data.get("settings", {}))
                if isinstance(data.get("games"), list) and data["games"]:
                    self.games = [g for g in data["games"] if g.get("id")]
                self.profiles = data.get("profiles", [])
                self.history = data.get("history", [])
                if isinstance(data.get("mods"), dict):
                    self.mods.update(data["mods"])
                    if not isinstance(self.mods.get("sounds"), dict):
                        self.mods["sounds"] = {}
        except Exception:
            pass

    def save_config(self):
        try:
            self.core.config_file.write_text(json.dumps(
                {"settings": self.settings, "games": self.games, "profiles": self.profiles,
                 "history": self.history, "mods": self.mods},
                indent=4, ensure_ascii=False), encoding="utf-8")
        except Exception:
            pass

