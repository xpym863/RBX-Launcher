class RobloxCore:
    DEFAULT_XML = """<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
\t<Item class="UserGameSettings" referent="RBX0">
\t\t<Properties>
\t\t\t<int name="SavedQualityLevel">0</int>
\t\t\t<token name="ControlMode">2</token>
\t\t\t<float name="MasterVolume">0.5</float>
\t\t\t<bool name="Fullscreen">false</bool>
\t\t</Properties>
\t</Item>
</roblox>
"""
    RENDER_FLAGS = {
        "Direct3D 11": "FFlagDebugGraphicsPreferD3D11",
        "Vulkan": "FFlagDebugGraphicsPreferVulkan",
        "OpenGL": "FFlagDebugGraphicsPreferOpenGL",
    }
    MANAGED_FLAGS = ["DFIntTaskSchedulerTargetFps", "FFlagDebugDisplayFPS",
                     "FFlagDisablePostFx"] + list(RENDER_FLAGS.values())

    def __init__(self):
        local = os.getenv("LOCALAPPDATA")
        if not local:
            raise EnvironmentError("Не удалось найти папку LOCALAPPDATA.")
        self.roblox_root = Path(local) / "Roblox"
        self.versions_dir = self.roblox_root / "Versions"
        self.settings_xml = self.roblox_root / "GlobalBasicSettings_13.xml"
        self.base_dir = app_dir()
        self.data_dir = self.base_dir / "launcher_data"
        self.backup_dir = self.data_dir / "backups"
        self.mods_dir = self.backup_dir / "mods"
        self.icons_dir = self.data_dir / "icons"
        self.config_file = self.data_dir / "config.json"
        for p in (self.data_dir, self.backup_dir, self.mods_dir, self.icons_dir):
            p.mkdir(parents=True, exist_ok=True)

    def get_latest_version_dir(self) -> Optional[Path]:
        if not self.versions_dir.exists():
            return None
        valid = []
        for folder in self.versions_dir.iterdir():
            exe = folder / "RobloxPlayerBeta.exe"
            if folder.is_dir() and exe.is_file():
                valid.append((exe.stat().st_mtime, folder))
        if not valid:
            return None
        valid.sort(key=lambda x: x[0], reverse=True)
        return valid[0][1]

    def sounds_dir(self):
        v = self.get_latest_version_dir()
        return v / "content" / "sounds" if v else None

    def fonts_dir(self):
        v = self.get_latest_version_dir()
        return v / "content" / "fonts" if v else None

    def cursors_dir(self):
        v = self.get_latest_version_dir()
        return v / "content" / "textures" / "Cursors" / "KeyboardMouse" if v else None

    def list_sounds(self):
        d = self.sounds_dir()
        if not d or not d.exists():
            return []
        return sorted([f for f in d.iterdir() if f.suffix.lower() in (".wav", ".mp3", ".ogg")],
                      key=lambda p: p.name)

    def list_fonts(self):
        d = self.fonts_dir()
        if not d or not d.exists():
            return []
        return sorted([f for f in d.iterdir() if f.suffix.lower() in (".otf", ".ttf")], key=lambda p: p.name)

    def list_cursors(self):
        d = self.cursors_dir()
        if not d or not d.exists():
            return []
        return sorted([f for f in d.iterdir() if f.suffix.lower() == ".png"], key=lambda p: p.name)

    def _mod_backup(self, category, filename):
        return self.mods_dir / category / filename

    def is_modified(self, category, filename):
        return self._mod_backup(category, filename).exists()

    def replace_client_file(self, category, target: Path, data: bytes):
        bak = self._mod_backup(category, target.name)
        bak.parent.mkdir(parents=True, exist_ok=True)
        if not bak.exists():
            shutil.copy2(target, bak)
        target.write_bytes(data)
        return True

    def restore_client_file(self, category, filename):
        bak = self._mod_backup(category, filename)
        if not bak.exists():
            return False
        base = {"sounds": self.sounds_dir(), "fonts": self.fonts_dir(), "cursors": self.cursors_dir()}[category]
        if not base:
            return False
        base.mkdir(parents=True, exist_ok=True)
        shutil.copy2(bak, base / filename)
        bak.unlink()
        return True

    def restore_category(self, category):
        d = self.mods_dir / category
        if not d.exists():
            return 0
        n = 0
        for bak in list(d.iterdir()):
            if self.restore_client_file(category, bak.name):
                n += 1
        return n

    @staticmethod
    def ui_to_internal_quality(level):
        level = max(1, min(10, int(level)))
        return int(round(1 + (level - 1) * 20 / 9))

    def ensure_settings_xml(self):
        if self.settings_xml.exists():
            return True
        try:
            self.roblox_root.mkdir(parents=True, exist_ok=True)
            self.settings_xml.write_text(self.DEFAULT_XML, encoding="utf-8")
            return True
        except Exception:
            return False

    @staticmethod
    def _set_prop(props, tag, name, value):
        for el in props:
            if el.tag == tag and el.attrib.get("name") == name:
                el.text = value
                return
        ET.SubElement(props, tag, {"name": name}).text = value

    def apply_xml_settings(self, graphics_level, shift_lock, volume, quiet=False):
        if not self.ensure_settings_xml():
            if not quiet:
                messagebox.showerror("Ошибка", "Не удалось создать файл настроек Roblox.")
            return False
        try:
            bak = self.backup_dir / self.settings_xml.name
            if not bak.exists():
                shutil.copy2(self.settings_xml, bak)
        except Exception:
            pass
        try:
            try:
                tree = ET.parse(self.settings_xml)
            except ET.ParseError:
                self.settings_xml.write_text(self.DEFAULT_XML, encoding="utf-8")
                tree = ET.parse(self.settings_xml)
            root = tree.getroot()
            props = None
            for item in root.iter("Item"):
                if item.attrib.get("class") == "UserGameSettings":
                    props = item.find("Properties")
                    break
            if props is None:
                item = ET.SubElement(root, "Item", {"class": "UserGameSettings", "referent": "RBX0"})
                props = ET.SubElement(item, "Properties")
            self._set_prop(props, "int", "SavedQualityLevel", str(self.ui_to_internal_quality(graphics_level)))
            self._set_prop(props, "token", "ControlMode", "1" if shift_lock else "2")
            self._set_prop(props, "float", "MasterVolume", str(round(max(0, min(100, volume)) / 100.0, 3)))
            tree.write(self.settings_xml, encoding="utf-8", xml_declaration=False)
            return True
        except PermissionError:
            if not quiet:
                messagebox.showerror("Ошибка доступа", "Закройте Roblox перед применением настроек!")
            return False
        except Exception as e:
            if not quiet:
                messagebox.showerror("Ошибка XML", f"Не удалось изменить настройки:\n{e}")
            return False

    def restore_backup(self):
        bak = self.backup_dir / self.settings_xml.name
        if not bak.exists():
            return False
        try:
            shutil.copy2(bak, self.settings_xml)
            return True
        except Exception:
            return False

    def apply_fast_flags(self, s, quiet=False):
        ver = self.get_latest_version_dir()
        if not ver:
            return False
        cs_dir = ver / "ClientSettings"
        cs_file = cs_dir / "ClientAppSettings.json"
        try:
            cs_dir.mkdir(parents=True, exist_ok=True)
            flags = {}
            if cs_file.exists():
                try:
                    flags = json.loads(cs_file.read_text(encoding="utf-8"))
                except Exception:
                    flags = {}
            for k in self.MANAGED_FLAGS:
                flags.pop(k, None)
            if int(s.get("fps", 0)) > 0:
                flags["DFIntTaskSchedulerTargetFps"] = int(s["fps"])
            if s.get("show_fps"):
                flags["FFlagDebugDisplayFPS"] = True
            if s.get("postfx_off"):
                flags["FFlagDisablePostFx"] = True
            pref = self.RENDER_FLAGS.get(s.get("rendering", "Авто"))
            if pref:
                for k in self.RENDER_FLAGS.values():
                    flags[k] = (k == pref)
            cs_file.write_text(json.dumps(flags, indent=4), encoding="utf-8")
            return True
        except Exception as e:
            if not quiet:
                messagebox.showerror("FastFlags", f"Не удалось записать флаги:\n{e}")
            return False

    def launch_menu(self):
        ver = self.get_latest_version_dir()
        if not ver:
            messagebox.showerror("Ошибка", "Клиент Roblox не найден на ПК!")
            return False
        subprocess.Popen([str(ver / "RobloxPlayerBeta.exe")])
        return True

    def launch_place(self, place_id):
        webbrowser.open(f"roblox://placeId={place_id}")
        return True

    @staticmethod
    def parse_place_id(text):
        text = (text or "").strip()
        m = re.search(r"games/(\d+)", text) or re.search(r"placeId=(\d+)", text)
        if m:
            return m.group(1)
        if text.isdigit():
            return text
        m = re.search(r"\d{4,}", text)
        return m.group(0) if m else None

    @staticmethod
    def fetch_remote(place_id):
        out = {"name": None, "icon": None}
        hdr = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"}
        try:
            req = urllib.request.Request(
                f"https://apis.roblox.com/universes/v1/places/{place_id}/universe", headers=hdr)
            uni = json.loads(urllib.request.urlopen(req, timeout=6).read().decode()).get("universeId")
            if not uni:
                return out
            try:
                req = urllib.request.Request(f"https://games.roblox.com/v1/games?universeIds={uni}", headers=hdr)
                data = json.loads(urllib.request.urlopen(req, timeout=6).read().decode()).get("data", [])
                if data:
                    out["name"] = data[0].get("name")
            except Exception:
                pass
            try:
                req = urllib.request.Request(
                    f"https://thumbnails.roblox.com/v1/games/icons?universeIds={uni}"
                    f"&returnPolicy=PlaceHolder&size=150x150&format=Png&isCircular=false", headers=hdr)
                data = json.loads(urllib.request.urlopen(req, timeout=6).read().decode()).get("data", [])
                url = data[0].get("imageUrl") if data else None
                if url:
                    out["icon"] = urllib.request.urlopen(urllib.request.Request(url, headers=hdr), timeout=8).read()
            except Exception:
                pass
        except Exception:
            pass
        return out

