def make_banner(w, h, accent):
    w, h = max(200, int(w)), max(80, int(h))
    base = Image.new("RGB", (w, h))
    d = ImageDraw.Draw(base)
    c1, c2, c3 = accent, hue_shift(accent, 0.07), hue_shift(accent, 0.16)
    for x in range(w):
        t = x / max(1, w - 1)
        c = mix(c1, c2, t * 2) if t < 0.5 else mix(c2, c3, (t - 0.5) * 2)
        d.line([(x, 0), (x, h)], fill=rgb(c))
    ov = Image.new("RGBA", (w, h), (0, 0, 0, 0))
    od = ImageDraw.Draw(ov)
    od.ellipse([w - 260, -90, w + 60, 230], fill=rgb(mix(accent, "#FFFFFF", 0.35)) + (70,))
    od.ellipse([w - 430, 40, w - 160, 300], fill=rgb(hue_shift(accent, 0.12)) + (60,))
    for i in range(-h, w, 28):
        od.line([(i, 0), (i + h, h)], fill=(255, 255, 255, 12), width=2)
    for x in range(w):
        a = int(195 * max(0.0, 1 - x / (w * 0.62)))
        od.line([(x, 0), (x, h)], fill=(8, 10, 16, a))
    return Image.alpha_composite(base.convert("RGBA"), ov).convert("RGB")

def make_logo(accent, size=44):
    img = Image.new("RGBA", (size, size), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)
    d.rounded_rectangle([0, 0, size - 1, size - 1], radius=max(4, int(size * 0.27)), fill=rgb(accent))
    d.rounded_rectangle([0, 0, size - 1, size // 2], radius=max(4, int(size * 0.27)),
                        fill=rgb(mix(accent, "#FFFFFF", 0.18)))
    d.text((size / 2, size / 2 + 1), "R", font=pil_font(int(size * 0.55)), fill=(255, 255, 255), anchor="mm")
    return img

def make_avatar(name, seed, size=84):
    h = (hash(seed) % 1000) / 1000.0
    r, g, b = colorsys.hsv_to_rgb(h, 0.62, 0.85)
    col = hx((r * 255, g * 255, b * 255))
    img = Image.new("RGBA", (size, size), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)
    d.rounded_rectangle([0, 0, size - 1, size - 1], radius=18, fill=rgb(col))
    d.rounded_rectangle([0, 0, size - 1, size // 2], radius=18, fill=rgb(mix(col, "#FFFFFF", 0.14)))
    letter = (name or "R").strip()[:1].upper() or "R"
    d.text((size / 2, size / 2 + 2), letter, font=pil_font(int(size * 0.45)), fill=(255, 255, 255), anchor="mm")
    return img

ARROW_PTS = [(0.06, 0.02), (0.06, 0.78), (0.26, 0.60), (0.38, 0.92),
