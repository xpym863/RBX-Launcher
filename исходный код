def make_icon_master(s=512):
    """Иконка приложения: градиентная плитка с буквой R."""
    top, mid, bot = "#4FA3FF", "#3D8BFF", "#8B5CF6"
    grad = Image.new("RGB", (s, s))
    gd = ImageDraw.Draw(grad)
    for y in range(s):
        t = y / (s - 1)
        c = rgb(mix(top, mid, t / 0.55)) if t < 0.55 else rgb(mix(mid, bot, (t - 0.55) / 0.45))
        gd.line([(0, y), (s, y)], fill=c)

    mask = Image.new("L", (s, s), 0)
    ImageDraw.Draw(mask).rounded_rectangle([0, 0, s - 1, s - 1], radius=int(s * 0.235), fill=255)
    tile = Image.new("RGBA", (s, s), (0, 0, 0, 0))
    tile.paste(grad, (0, 0), mask)

    ov = Image.new("RGBA", (s, s), (0, 0, 0, 0))
    od = ImageDraw.Draw(ov)
    od.ellipse([s * 0.45, -s * 0.25, s * 1.05, s * 0.45], fill=(255, 255, 255, 46))
    od.ellipse([s * 0.62, s * 0.02, s * 1.02, s * 0.40], fill=(255, 255, 255, 38))
    od.ellipse([-s * 0.30, s * 0.55, s * 0.50, s * 1.25], fill=(20, 10, 60, 80))
    step = max(8, s // 9)
    for i in range(-s, s, step):
        od.line([(i, 0), (i + s, s)], fill=(255, 255, 255, 12), width=max(2, s // 72))
    od.rounded_rectangle([s * 0.05, s * 0.045, s * 0.95, s * 0.50],
                         radius=int(s * 0.19), fill=(255, 255, 255, 24))
    b = max(2, s // 96)
    od.rounded_rectangle([b, b, s - 1 - b, s - 1 - b],
                         radius=int(s * 0.235) - b, outline=(255, 255, 255, 60), width=b)
    ov.putalpha(ImageChops.multiply(ov.getchannel("A"), mask))
    tile = Image.alpha_composite(tile, ov)

    tl = Image.new("RGBA", (s, s), (0, 0, 0, 0))
    td = ImageDraw.Draw(tl)
    f = pil_font(int(s * 0.58))
    cx, cy = s / 2, s * 0.545
    td.text((cx + s * 0.012, cy + s * 0.020), "R", font=f, fill=(10, 14, 30, 120), anchor="mm")
    td.text((cx, cy), "R", font=f, fill=(255, 255, 255, 255), anchor="mm")
    tl.putalpha(ImageChops.multiply(tl.getchannel("A"), mask))
    return Image.alpha_composite(tile, tl)

def export_icon(folder: Path) -> Path:
    folder.mkdir(parents=True, exist_ok=True)
    m = make_icon_master(512)
    m.resize((256, 256), Image.LANCZOS).save(folder / "icon.png")
    m.save(folder / "icon.ico", format="ICO",
           sizes=[(16, 16), (24, 24), (32, 32), (48, 48), (64, 64), (128, 128), (256, 256)])
    return folder / "icon.ico"

def find_or_make_icon(data_dir: Path) -> Optional[Path]:
    for p in (res_dir() / "icon.ico", app_dir() / "icon.ico", data_dir / "icon.ico"):
        if p.exists():
            return p
    try:
        return export_icon(data_dir)
    except Exception:
        return None

def setup_window_icon(window, data_dir: Path):
    ico = find_or_make_icon(data_dir)
    if not ico:
        return
    try:
        window.iconbitmap(default=str(ico))
    except Exception:
        try:
            window.iconbitmap(str(ico))
        except Exception:
            pass
    png = ico.with_suffix(".png")
    if png.exists():
        try:
            ph = PhotoImage(file=str(png))
            window.iconphoto(True, ph)
            window._icon_photo = ph
        except Exception:
            pass

