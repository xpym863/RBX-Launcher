def make_cursor(kind, size, accent):
    s = max(16, int(size))
    img = Image.new("RGBA", (s, s), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)
    pts = [(x * s, y * s) for x, y in ARROW_PTS]
    if kind in ("white", "black", "neon"):
        fill = {"white": (255, 255, 255), "black": (20, 20, 24), "neon": rgb(accent)}[kind]
        outline = (255, 255, 255) if kind == "black" else (0, 0, 0)
        if kind == "neon":
            glow = Image.new("RGBA", (s, s), (0, 0, 0, 0))
            gd = ImageDraw.Draw(glow)
            big = [(x * s * 1.12 - s * 0.05, y * s * 1.12 - s * 0.05) for x, y in ARROW_PTS]
            gd.polygon(big, fill=rgb(accent) + (90,))
            img = Image.alpha_composite(img, glow)
            d = ImageDraw.Draw(img)
        d.polygon(pts, fill=fill, outline=outline, width=max(1, s // 24))
    elif kind == "cross":
        c = rgb(accent)
        w = max(2, s // 14)
        d.line([(s / 2, s * 0.08), (s / 2, s * 0.38)], fill=c, width=w)
        d.line([(s / 2, s * 0.62), (s / 2, s * 0.92)], fill=c, width=w)
        d.line([(s * 0.08, s / 2), (s * 0.38, s / 2)], fill=c, width=w)
        d.line([(s * 0.62, s / 2), (s * 0.92, s / 2)], fill=c, width=w)
        d.ellipse([s * 0.42, s * 0.42, s * 0.58, s * 0.58], fill=c)
    elif kind == "dot":
        c = rgb(accent)
        d.ellipse([s * 0.28, s * 0.28, s * 0.72, s * 0.72], outline=c, width=max(2, s // 16))
        d.ellipse([s * 0.42, s * 0.42, s * 0.58, s * 0.58], fill=c)
    else:
        d.polygon([(s * 0.2, s * 0.1), (s * 0.2, s * 0.7), (s * 0.62, s * 0.45)], fill=rgb(accent))
    return img

