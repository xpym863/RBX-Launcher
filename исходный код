            self.opt_render.configure(button_hover_color=a)
            self.opt_lcursor.configure(button_hover_color=a)
        except Exception:
            pass
        self.logo_img = ctk.CTkImage(make_logo(a), size=(42, 42))
        self.logo_label.configure(image=self.logo_img)
        for kind, b in self.cursor_buttons.items():
            b.configure(image=ctk.CTkImage(make_cursor(kind, 48, a), size=(48, 48)))
        self.regen_banner()
        self.show_page(self.current_page)

    # ---------------- баннер / сетка ----------------
    def schedule_banner(self):
        if self._banner_after:
            self.after_cancel(self._banner_after)
        self._banner_after = self.after(140, self.regen_banner)

    def regen_banner(self):
        w = self.banner.winfo_width()
        h = self.banner.winfo_height()
        if w < 50 or h < 50:
            return
        self.banner_ctk = ctk.CTkImage(make_banner(w, h, self.accent), size=(w, h))
        self.banner_img_label.configure(image=self.banner_ctk)
        self.banner_img_label.place(x=0, y=0)

    def schedule_grid(self, width):
        self._grid_width = width
        if self._grid_after:
            self.after_cancel(self._grid_after)
        self._grid_after = self.after(140, self.rebuild_games)

    def on_search(self):
        self._search = self.entry_search.get().lower().strip()
        self.rebuild_games()

    def rebuild_games(self):
        for w in self.games_grid.winfo_children():
            w.destroy()
        self.card_buttons.clear()
        cols = max(2, (self._grid_width - 10) // 170)
        shown = [g for g in self.games
                 if self._search in (g.get("name") or "").lower() or self._search in g["id"]]
        self.lbl_count.configure(text=f"{len(shown)} из {len(self.games)}")
        if not shown:
            ctk.CTkLabel(self.games_grid,
                         text="Ничего не найдено. Вставьте Place ID внизу и нажмите «＋ В библиотеку».",
                         font=F(12), text_color=MUTED).grid(row=0, column=0, columnspan=cols, pady=20)
            return
        for i, g in enumerate(shown):
            self.make_card(g, i // cols, i % cols)

    def make_card(self, g, row, col):
        pid = g["id"]
        name = g.get("name") or f"Place {pid}"
        frame = ctk.CTkFrame(self.games_grid, fg_color="transparent")
        frame.grid(row=row, column=col, padx=5, pady=5, sticky="nsew")
        self.games_grid.grid_columnconfigure(col, weight=1)
        icon = self.icons.get(pid) or ctk.CTkImage(make_avatar(name, pid), size=(84, 84))
        btn = ctk.CTkButton(frame, text=f"{name}\nID {pid}", image=icon, compound="top",
                            width=160, height=170, corner_radius=14, font=F(12, "bold"),
                            fg_color=CARD, hover_color=CARD2, border_width=1, border_color=BORDER,
                            text_color=TEXT, command=lambda p=pid, n=name: self.launch_place(p, n))
        btn.pack(fill="both", expand=True)
        self.card_buttons[pid] = btn
        ctk.CTkButton(frame, text="✕", width=24, height=24, corner_radius=12, font=F(11, "bold"),
                      fg_color=mix(CARD, "#000000", 0.25), hover_color=RED, text_color=MUTED,
                      command=lambda p=pid: self.delete_game(p)).place(relx=1.0, x=-8, y=8, anchor="ne")

    # ---------------- библиотека ----------------
    def load_icons(self):
        for g in self.games:
            f = self.core.icons_dir / f"{g['id']}.png"
            if f.exists():
                try:
                    self.icons[g["id"]] = ctk.CTkImage(Image.open(f).convert("RGBA"), size=(84, 84))
                    continue
                except Exception:
                    pass
            threading.Thread(target=self.fetch_worker, args=(g["id"],), daemon=True).start()

    def fetch_worker(self, pid):
        info = RobloxCore.fetch_remote(pid)
        try:
            self.after(0, lambda: self.apply_remote(pid, info))
        except Exception:
            pass

    def apply_remote(self, pid, info):
        game = next((g for g in self.games if g["id"] == pid), None)
        if not game:
            return
        changed = False
        if info.get("name") and (not game.get("name") or game["name"] == f"Place {pid}"):
            game["name"] = info["name"]
            changed = True
        if info.get("icon"):
            try:
                (self.core.icons_dir / f"{pid}.png").write_bytes(info["icon"])
                self.icons[pid] = ctk.CTkImage(Image.open(io.BytesIO(info["icon"])).convert("RGBA"),
                                               size=(84, 84))
                changed = True
            except Exception:
                pass
        if changed:
            self.save_config()
            btn = self.card_buttons.get(pid)
            if btn:
                try:
                    btn.configure(text=f"{game.get('name')}\nID {pid}", image=self.icons.get(pid))
                except Exception:
                    pass

    def on_add(self):
        pid = RobloxCore.parse_place_id(self.entry_place.get())
        if not pid:
            self.toast("Введите Place ID или ссылку на игру", "err")
            return
        if any(g["id"] == pid for g in self.games):
            self.toast("Эта игра уже в библиотеке", "warn")
            return
        self.games.append({"id": pid, "name": f"Place {pid}"})
        self.save_config()
        self.entry_place.delete(0, "end")
        self.rebuild_games()
        threading.Thread(target=self.fetch_worker, args=(pid,), daemon=True).start()
        self.toast(f"Игра {pid} добавлена в библиотеку", "ok")

    def delete_game(self, pid):
        idx = next((i for i, g in enumerate(self.games) if g["id"] == pid), None)
        if idx is None:
            return
        removed = self.games.pop(idx)
        self.save_config()
        self.rebuild_games()
        self.toast(f"Удалено: {removed.get('name')}", "warn",
                   undo=lambda: self.restore_game(idx, removed))

    def restore_game(self, idx, game):
        self.games.insert(min(idx, len(self.games)), game)
        self.save_config()
        self.rebuild_games()
        self.toast(f"Возвращено: {game.get('name')}", "ok")

    # ---------------- запуск ----------------
    def record_history(self, pid, name):
        self.history = [h for h in self.history if h.get("id") != pid]
        self.history.insert(0, {"id": pid, "name": name or f"Place {pid}",
                                "ts": time.strftime("%d.%m.%Y %H:%M")})
        self.history = self.history[:12]
        self.save_config()
        self.refresh_recent()

    def apply_before_launch(self, quiet):
        if not self.settings["apply_on_launch"]:
            return
        vol = 0 if self.var_mute.get() else self.settings["volume"]
        self.core.apply_xml_settings(self.settings["graphics"], self.settings["shiftlock"], vol, quiet=quiet)
        self.core.apply_fast_flags(self.settings, quiet=True)

    def after_launch(self):
        if self.settings["close_after"]:
            self.after(900, self.destroy)

    def launch_place(self, pid, name=None):
        self.apply_before_launch(quiet=True)
        self.core.launch_place(pid)
        self.record_history(pid, name)
        self.toast(f"Запуск: {name or pid} …", "ok")
        self.after_launch()

    def on_menu(self):
        self.apply_before_launch(quiet=False)
        if self.core.launch_menu():
            self.toast("Запуск клиента Roblox …", "ok")
        self.after_launch()

    def on_play(self):
        pid = RobloxCore.parse_place_id(self.entry_place.get())
        self.apply_before_launch(quiet=False)
        if pid:
            game = next((g for g in self.games if g["id"] == pid), None)
            self.core.launch_place(pid)
            self.record_history(pid, game.get("name") if game else None)
            self.toast(f"Запуск игры {pid} …", "ok")
        else:
            if self.core.launch_menu():
                self.toast("Запуск клиента Roblox …", "ok")
        self.after_launch()


if __name__ == "__main__":
    set_taskbar_id()
    app = LauncherApp()

    def fix_russian_shortcuts(event):
        if event.state & 0x4:
            if event.keycode == 86:
                event.widget.event_generate("<<Paste>>")
                return "break"
            elif event.keycode == 67:
                event.widget.event_generate("<<Copy>>")
                return "break"
            elif event.keycode == 88:
                event.widget.event_generate("<<Cut>>")
                return "break"
            elif event.keycode == 65:
                event.widget.event_generate("<<SelectAll>>")
                return "break"

    app.bind_all("<KeyPress>", fix_russian_shortcuts, add="+")
    app.mainloop()

