    # ---------------- живые настройки ----------------
    def on_gfx(self, v):
        self.settings["graphics"] = int(v)
        self.lbl_gfx.configure(text=f"Уровень графики: {int(v)} / 10")
        self.save_config()

    def on_shift(self):
        self.settings["shiftlock"] = self.var_shift.get()
        self.save_config()

    def on_volume(self, v):
        v = int(v)
        self.settings["volume"] = v
        self.lbl_vol.configure(text=f"Общая громкость: {v}%")
        self.var_mute.set(v == 0)
        if v > 0:
            self._prev_volume = v
        self.save_config()

    def on_mute(self):
        if self.var_mute.get():
            self._prev_volume = self.settings["volume"] or self._prev_volume
            self.slider_vol.set(0)
            self.on_volume(0)
        else:
            self.slider_vol.set(self._prev_volume)
            self.on_volume(self._prev_volume)

    def set_flag(self, key, value):
        self.settings[key] = value
        self.save_config()
        self.core.apply_fast_flags(self.settings, quiet=True)
        self.toast("FastFlags обновлены — применятся при запуске клиента", "ok")

    def set_fps(self, v):
        self.entry_fps.delete(0, "end")
        self.entry_fps.insert(0, str(v))
        self.commit_fps()

    def commit_fps(self):
        try:
            v = max(0, min(1000, int(self.entry_fps.get())))
        except ValueError:
            v = 0
        self.entry_fps.delete(0, "end")
        self.entry_fps.insert(0, str(v))
        self.set_flag("fps", v)

    def apply_flags_now(self):
        if self.core.apply_fast_flags(self.settings):
            self.toast("FastFlags записаны в ClientAppSettings.json", "ok")
        else:
            self.toast("Клиент Roblox не найден", "err")

    def on_restore(self):
        if self.core.restore_backup():
            self.toast("Оригинальные настройки Roblox восстановлены", "ok")
        else:
            self.toast("Бэкап ещё не создан", "warn")

    def restore_one(self, cat, name):
        if self.core.restore_client_file(cat, name):
            if cat == "sounds":
                self.mods["sounds"].pop(name, None)
                self.save_config()
            self.toast(f"Восстановлено: {name}", "ok")
        else:
            self.toast("Бэкап не найден", "warn")
        self.refresh_mod_labels(cat)

    def restore_cat(self, cat):
        n = self.core.restore_category(cat)
        if cat == "sounds":
            self.mods["sounds"] = {}
        elif cat == "fonts":
            self.mods["font"] = None
        elif cat == "cursors":
            self.mods["cursor"] = None
        self.save_config()
        self.toast(f"Восстановлено файлов: {n}" if n else "Изменённых файлов не было",
                     "ok" if n else "warn")
        if cat == "sounds":
            self.refresh_sound_rows()
        elif cat == "fonts":
            self.refresh_font_status()
        else:
            self.refresh_cursor_status()

    def refresh_mod_labels(self, cat):
        if cat == "sounds":
            for name, lbl in self.sound_status.items():
                mod = self.core.is_modified(cat, name)
                try:
                    lbl.configure(text="изменён" if mod else "оригинал",
                                  text_color=AMBER if mod else MUTED)
                except Exception:
                    pass
        elif cat == "fonts":
            self.refresh_font_status()
        elif cat == "cursors":
            self.refresh_cursor_status()

    def apply_preset(self, gfx, fps, post):
        self.settings.update({"graphics": gfx, "fps": fps, "postfx_off": post})
        self.save_config()
        self.refresh_controls()
        self.core.apply_fast_flags(self.settings, quiet=True)
        self.toast(f"Пресет применён: графика {gfx}, FPS {fps}", "ok")

    def set_accent(self, name):
        self.settings["accent"] = name
        self.accent = ACCENTS[name]
        self.save_config()
        self.refresh_accent_widgets()
        self.toast(f"Акцент: {name}", "ok")

    def refresh_accent_widgets(self):
        a = self.accent
        hov = mix(a, "#FFFFFF", 0.18)
        for s in self._accent_sliders:
            try:
                s.configure(progress_color=a, button_color=a, button_hover_color=mix(a, "#FFFFFF", 0.25))
            except Exception:
                pass
        for s in self._accent_switches:
            try:
                s.configure(progress_color=a)
            except Exception:
                pass
        for b in self._accent_buttons:
            try:
                b.configure(fg_color=a, hover_color=hov)
            except Exception:
                pass
